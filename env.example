# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
ADMIN_USER_IDS=123456789

# LLM: gemini | openai | deepseek | openrouter
LLM_PROVIDER=gemini
LLM_API_KEY=AIzaSy...
LLM_MODEL=gemini-2.5-flash-lite
# Optional override (proxy/Azure/self-hosted). Empty = provider default.
LLM_API_BASE_URL=
# Pipeline tuning (optional)
LLM_CONCURRENCY=4
LLM_RATE_PER_MINUTE=60
TELEGRAM_RATE_PER_MINUTE=19

# PostgreSQL (Neon) — dedup + curate queue
DATABASE_URL=postgresql://postgres:***@localhost:5432/ChannelUp

# Multi-channel feed definitions live in `channels.json` (copy from channels.json.example).
# Optional override for its path:
# CONFIG_FILE=channels.json