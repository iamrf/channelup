# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
ADMIN_USER_IDS=123456789

# LLM: gemini | openai | deepseek | openrouter
LLM_PROVIDER=gemini
LLM_API_KEY=AIzaSy...
LLM_MODEL=gemini-2.0-flash
# Optional override (proxy/Azure/self-hosted). Empty = provider default.
LLM_API_BASE_URL=

# Scheduling (only used by the always-on `python -m channelup`)
PUBLISH_INTERVAL_MINUTES=30

# PostgreSQL (Neon) — dedup store
DATABASE_URL=postgresql://postgres:***@localhost:5432/ChannelUp

# Multi-channel definitions live in `channels.json` (copy from channels.json.example).
# Optional override for its path:
# CONFIG_FILE=channels.json