# ChannelUp secrets & pipeline tuning.
# Copy to `.env` and fill in. NEVER commit this file.
# Feed/channel definitions and prompts live in `channels.json` (see channels.json.example).

# ── Telegram ─────────────────────────────────────────────────────────────────
# Bot token from @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Comma-separated Telegram user IDs allowed to run /start /publish_now /status
ADMIN_USER_IDS=123456789

# ── LLM provider ─────────────────────────────────────────────────────────────
# provider: gemini | openai | deepseek | openrouter
LLM_PROVIDER=gemini
LLM_API_KEY=AIzaSy...            # key for the chosen provider
LLM_MODEL=gemini-2.5-flash-lite # flash-lite: cheap + fast for rewrites
# Optional override (proxy/Azure/self-hosted). Leave empty for the provider default.
LLM_API_BASE_URL=

# ── Pipeline tuning (optional) ───────────────────────────────────────────────
LLM_CONCURRENCY=4               # max parallel LLM calls
LLM_RATE_PER_MINUTE=60          # LLM token-bucket refill per minute
TELEGRAM_RATE_PER_MINUTE=19     # global Telegram cap (overridden per channel in channels.json)

# ── Storage (Neon Postgres) ──────────────────────────────────────────────────
# Connection string for the dedup + curate-queue database.
DATABASE_URL=postgresql://postgres:***@localhost:5432/ChannelUp

# ── Config file ──────────────────────────────────────────────────────────────
# Optional override for the channels/feed definitions file.
# CONFIG_FILE=channels.json