# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TARGET_CHANNEL_IDS=-1001234567890,@my_public_channel
ADMIN_USER_IDS=123456789

# LLM: gemini | openai | deepseek | openrouter
LLM_PROVIDER=gemini
LLM_API_KEY=AIzaSy...
LLM_MODEL=gemini-2.0-flash
# Optional override (proxy/Azure/self-hosted). Empty = provider default.
LLM_API_BASE_URL=

# Sources
RSS_SOURCES=https://feeds.bbci.co.uk/news/rss.xml,https://www.theverge.com/rss/index.xml

# Scheduling
PUBLISH_INTERVAL_MINUTES=30
MAX_ITEMS_PER_RUN=5
POST_DELAY_SECONDS=5

# Content
LANGUAGE=en
# SYSTEM_PROMPT=inline prompt, {language} is substituted
# SYSTEM_PROMPT_FILE=prompt.txt

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/ChannelUp
